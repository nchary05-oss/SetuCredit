# SetuCredit — backend environment template.
# Copy to .env in the repo root:  make setup   (or:  cp .env.example .env)
# All values below are dev-safe defaults; anything you don't set keeps the
# in-code default in backend/app/config.py and stays on deterministic stubs.

# ── Core ────────────────────────────────────────────────────────────────────
# ENV=dev enables dev_otp in API responses. NEVER ship a deployment with dev.
ENV=dev
DATABASE_URL=postgresql+asyncpg://setucredit:setucredit@localhost:5432/setucredit
REDIS_URL=redis://localhost:6379/0
SCORING_SERVICE_URL=http://localhost:8001

# Lender webhook — unset/empty means appraisal skips the NBFC push.
PARTNER_WEBHOOK_URL=
# HMAC secret for inbound/outbound webhooks. MUST be changed outside dev.
WEBHOOK_SECRET=dev-webhook-secret

# ── TTLs (seconds) ──────────────────────────────────────────────────────────
SESSION_TTL_SECONDS=3600
OTP_TTL_SECONDS=300
CONSENT_TTL_SECONDS=900
DPI_TIMEOUT_SECONDS=5.0

# ── ULI (RBI gateway) — stub by default; live + creds routes via UliApiAdapter
ULI_MODE=stub
ULI_BASE_URL=https://extgw.nonprod.rbihub.io
ULI_TOKEN_URL=https://auth.nonprod.rbihub.io/oauth/token
ULI_CLIENT_ID=
ULI_CLIENT_SECRET=
ULI_MTLS_CERT=
ULI_MTLS_KEY=

# ── OTP delivery — stub is a no-op sender; sms + creds sends real SMS
OTP_MODE=stub
OTP_MAX_ATTEMPTS=5
SMS_BASE_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=

# ── UIDAI OTP auth — stub simulates txnId + registered-mobile flow
UIDAI_MODE=stub
UIDAI_BASE_URL=
UIDAI_AUA_CODE=
UIDAI_ASA_LICENSE_KEY=
UIDAI_API_KEY=
